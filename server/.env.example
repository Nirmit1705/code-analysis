# Application
APP_ENV=development
DEBUG=true

# PostgreSQL — percent-encode special characters in the password (e.g. @ -> %40)
DATABASE_URL=postgresql://postgres:password@localhost:5432/codebase_intelligence

# Redis (Celery broker + result backend)
REDIS_URL=redis://localhost:6379/0

# Auth
SECRET_KEY=change-me-generate-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Fernet key (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
TOKEN_ENCRYPTION_KEY=change-me-generate-a-fernet-key

# GitHub App
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# Smee.io — development-only webhook relay; production points the GitHub App
# webhook directly at the deployed FastAPI URL instead.
SMEE_WEBHOOK_URL=https://smee.io/YOUR_CHANNEL_ID

# LLM (provider-agnostic behind app/ai/provider.py — Phase 8)
# Groq (free, OpenAI-compatible chat-completions API) — chosen over Gemini for faster
# non-streaming latency and stricter constrained-decoding JSON-schema guarantees.
# See docs/PHASE_8_PLAN.md design decision #2. Exact model verified empirically in 8.1.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Embeddings (Phase 7) — local, matched pair with the reranker below.
# EMBEDDING_DIM fixes the pgvector column width (server/app/models/rag_chunk.py).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIM=1024

# Reranker (Phase 7.4) — the community seq-cls conversion (standard
# classification head), not the official Qwen/Qwen3-Reranker-0.6B checkpoint
# (which needs hand-rolled yes/no-logit scoring — deliberately avoided).
RERANKER_PROVIDER=local
RERANKER_MODEL=tomaarsen/Qwen3-Reranker-0.6B-seq-cls

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Development
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:8000
